# --- Featherless AI (partner integration) ---------------------------------- #
# Serverless open-source LLM inference, OpenAI-compatible.
# Without this Magno runs its deterministic quant policy instead and says so in
# the execution stream. Get a key at https://featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# --- Optional secondary reasoner ------------------------------------------- #
# Tried only if the Featherless call fails. Leave blank to skip.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Alpaca ---------------------------------------------------------------- #
# NOT required for the web app: keys are entered at /onboarding and held in
# memory only. Set these two ONLY to run the MCP server standalone
# (python -m app.agents.alpaca_mcp) or to boot the agent headless.
# Paper keys only — the trading client is constructed with paper=True.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Universe & risk defaults ---------------------------------------------- #
MAGNO_UNIVERSE=SPY,QQQ,NVDA,AAPL
MAX_SPREAD_PCT=0.05
MAX_ALLOCATION_PCT=0.10
DELTA_DRIFT_THRESHOLD=1.0
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=6

# --- Loop cadences (seconds) ----------------------------------------------- #
TELEMETRY_INTERVAL_S=1.0
HEDGE_INTERVAL_S=5.0
REASONING_INTERVAL_S=60.0
