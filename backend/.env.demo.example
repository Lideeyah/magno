# ---------------------------------------------------------------------------
# Dedicated auto-demo broker configuration
#
#   cp .env.demo.example .env.demo   and fill in
#   uvicorn app.demo_main:app --port 8001 --env-file .env.demo
#
# Separate process, separate port, separate session from the production backend
# on :8000. Starting or stopping this never affects a live trading session.
# ---------------------------------------------------------------------------

DEMO_ALPACA_API_KEY=""
DEMO_ALPACA_SECRET_KEY=""
DEMO_ALPACA_BASE_URL="https://paper-api.alpaca.markets"
DEMO_FEATHERLESS_API_KEY=""
DEMO_PORT=3001
DEMO_BACKEND_PORT=8001

# The demo reasoner falls back to the primary key if DEMO_FEATHERLESS_API_KEY
# is blank, so the reasoning panel still renders.
FEATHERLESS_API_KEY=""
