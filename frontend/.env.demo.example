# ---------------------------------------------------------------------------
# Isolated auto-demo sandbox
#
# Copy to `.env.demo` and fill in. Nothing here touches the primary terminal on
# :3000 — the demo runs on its own port, with its own build directory, against
# the same read-only backend telemetry.
#
#   npm run demo        -> http://localhost:3001/demo
# ---------------------------------------------------------------------------

# Port for the demo sandbox. Must not collide with the primary app on 3000.
DEMO_PORT=3001

# Where the Magno backend is listening. The demo is a *read* client: it renders
# live telemetry and never submits an order.
NEXT_PUBLIC_MAGNO_API=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Broker credentials
#
# The demo does NOT hold Alpaca or Featherless keys of its own, deliberately.
#
# Credentials live in the backend process and are supplied once at onboarding;
# they are never written to disk and never sent to a browser. Handing the demo
# its own copy would mean a second set of live trading keys sitting in a file,
# for a surface that only ever reads.
#
# Instead the demo attaches to an existing backend session by id — see
# `SESSION HANDOFF` below. The keys stay where they already are.
#
# If you later want the demo to boot its own independent trading session, that
# needs a backend endpoint that mints a session from environment credentials,
# and a backend restart. Those variables would go here:
#
#   DEMO_ALPACA_API_KEY=""
#   DEMO_ALPACA_SECRET_KEY=""
#   DEMO_ALPACA_BASE_URL="https://paper-api.alpaca.markets"
#   DEMO_FEATHERLESS_API_KEY=""
#
# They are commented out because adding them today would require restarting the
# backend, which drops every live session — including the book you are about to
# record.
# ---------------------------------------------------------------------------

# SESSION HANDOFF
#
# localStorage is per-origin, so :3001 cannot see the session the terminal
# stored on :3000. Pass it once in the URL and the demo remembers it:
#
#   http://localhost:3001/demo?session=<session-id>
#
# The id is visible in the terminal header, or from the backend log line
# `WebSocket /ws/telemetry?session_id=...`.
